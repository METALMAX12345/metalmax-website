# Скопіюйте цей файл у .env і заповніть значеннями з вашого проєкту Supabase
# (Project Settings → API у Supabase Dashboard).
#
# Якщо залишити .env порожнім/відсутнім — сайт продовжує працювати у локальному
# демо-режимі (localStorage), як і раніше.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
